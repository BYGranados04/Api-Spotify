# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA se sube al repositorio.

# Conexión a PostgreSQL (driver psycopg 3).
# Si la contraseña tiene caracteres especiales (@ : / # %), codifíquelos en formato URL.
DATABASE_URL=postgresql+psycopg://musicflow_app:CAMBIAR_PASSWORD@localhost:5432/musicflow

# Clave secreta para firmar los JWT (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
